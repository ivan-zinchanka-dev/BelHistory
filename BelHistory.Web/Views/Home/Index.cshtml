@model IReadOnlyList<Category>

<h1>Каталог</h1>
<ul>
    @foreach (var category in Model)
    {
        <li>
            @category.LocalizedObject.Name.Ru
            @if (category.SubCategories.Any())
            {
                <ul>
                    @foreach (Category sub in category.SubCategories)
                    {
                        <li>@sub.LocalizedObject.Name.Ru</li>
                    }
                </ul>
            }
        </li>
    }
</ul>
