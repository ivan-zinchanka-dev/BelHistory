@model IReadOnlyList<Category>

<h1>Каталог</h1>
<ul>
    @foreach (Category category in Model)
    {
        <li>
            <a asp-controller="Home" asp-action="Explore" 
               asp-route-categoryId="@category.LocalizedObject.Id">
                @category.LocalizedObject.Name.Ru
            </a>
            
            @if (category.SubCategories.Any())
            {
                <ul>
                    @foreach (Category subCategory in category.SubCategories)
                    {
                        <li>
                            <a asp-controller="Home" asp-action="Explore"
                               asp-route-categoryId="@category.LocalizedObject.Id"
                               asp-route-subCategoryId="@subCategory.LocalizedObject.Id">
                                @subCategory.LocalizedObject.Name.Ru
                            </a>
                        </li>
                    }
                </ul>
            }
        </li>
    }
</ul>
