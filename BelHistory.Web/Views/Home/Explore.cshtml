@using System.Globalization
@model ExploreViewModel

<div>@Model.GetPath(CultureInfo.CurrentCulture)</div>

<div>
    <ul class="docs-list">
        @foreach (HistoricalDocument document in Model.Documents)
        {
            <li class="docs-list-item">
                <a asp-action="Details"
                   asp-route-documentId="@document.Id">
                    @document.Title.Ru
                </a>
            </li>
        }
    </ul>
</div>
