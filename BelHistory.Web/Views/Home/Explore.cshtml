@using System.Globalization
@model ExploreViewModel

<div>@Model.GetPath(CultureInfo.CurrentCulture)</div>

<div>
    <ul class="docs-list">
        @foreach (HistoricalDocument document in Model.Documents)
        {
            <li class="docs-list-item">@document.Title.Ru</li>
        }
    </ul>
</div>
