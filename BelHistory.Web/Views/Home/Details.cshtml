@using BelHistory.Domain.API.Extensions
@model HistoricalDocument

<div>@Model.GetFullPath()</div>

<div class="doc-container">

    @* TODO Custom tag-helper? *@
    <div class="doc-image">
        <img src="@Url.Action("DownloadFile", "Home", new { fileId = Model.ImageId })" 
             alt="Изображение отсутсвует">
    </div>
    
    <div class="doc-info">
        <h1>@Model.Title</h1>

        <dl>
            <dt>Автор:</dt>
            <dd>@Model.Author</dd>

            <dt>Язык оригинала:</dt>
            <dd>@Model.Language.Name</dd>
            
            <dt>Время написания:</dt>
            <dd>@Model.CreationTime</dd>

            <dt>Описание:</dt>
            <dd>@Model.Description</dd>
        </dl>

        <ul>
            @foreach (FileInstance fileInstance in Model.FileInstances)
            {
                <li>
                    @fileInstance.Title
                    <a asp-controller="Home"
                       asp-action="DownloadFile"
                       asp-route-fileId="@fileInstance.FileId"
                       class="download-button">
                        Скачать документ
                    </a>
                </li>
            }
        </ul>
       
    </div>
</div>