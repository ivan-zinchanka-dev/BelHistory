@using BelHistory.Domain.API.Extensions
@model HistoricalDocument

<div>@Model.GetFullPath()</div>

<div class="doc-container">

    <div class="doc-image">
        <img src="../img/test.png" alt="Обложка документа">
    </div>
    
    <div class="doc-info">
        <h1>@Model.Title</h1>

        <dl>
            <dt>Автор:</dt>
            <dd>@Model.Author</dd>

            <dt>Время написания:</dt>
            <dd>@Model.CreationTime</dd>

            <dt>Описание:</dt>
            <dd>@Model.Description</dd>
        </dl>

        <a asp-controller="Home"
           asp-action="DownloadFile"
           asp-route-fileId="@Model.FileId"
           class="download-button">
            Скачать документ
        </a>
       
    </div>
</div>